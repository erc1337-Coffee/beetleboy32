{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "scripts/docs/Dockerfile",
    "watchPatterns": [
      "README.md",
      "ROADMAP.md",
      "project.env",
      "railway.json",
      "docs/**",
      "demo/gifs/**",
      "scripts/docs/**",
      "assets/fonts/**",
      "assets/icon_beetle.png"
    ]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE"
  }
}
